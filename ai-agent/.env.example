# NexOS ERP LangChain Agent Configuration
ERP_BACKEND_URL=http://localhost:8080
DEFAULT_COMPANY_ID=1
HOST=0.0.0.0
PORT=8000

# Optional LLM API Keys (Supports OpenAI, Google Gemini, OpenRouter)
# If left blank, the agent runs in local deterministic tool execution mode.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
